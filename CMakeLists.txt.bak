
cmake_minimum_required(VERSION 3.16)

project(rk3576_multimodal LANGUAGES CXX)

set(CMAKE_CXX_STANDARD 17)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_CXX_EXTENSIONS OFF)

find_package(Threads REQUIRED)

# ======================================================
# 1. RKLLM / VLM backend options
# ======================================================

option(
    BUILD_WITH_RKLLM
    "Require a real RKLLM SDK adapter (not included yet)"
    OFF
)

option(
    BUILD_WITH_VLM
    "Require a real VLM SDK adapter (not included yet)"
    OFF
)

if(BUILD_WITH_RKLLM OR BUILD_WITH_VLM)
    message(FATAL_ERROR
        "RK3576 Runtime/SDK not available: "
        "this repository has no verified SDK adapter. "
        "Provide RK3576 headers/libraries/models "
        "and implement the adapter before enabling "
        "these options."
    )
endif()

# ======================================================
# 2. Project compiler warnings
# ======================================================

function(project_warnings target)
    if(MSVC)
        target_compile_options(
            ${target} PRIVATE /W4 /utf-8
        )
    else()
        target_compile_options(
            ${target} PRIVATE
            -Wall -Wextra -Wpedantic
        )
    endif()
endfunction()

# ======================================================
# 3. Multimodal core
# ======================================================

add_library(multimodal_core
    src/video/latest_frame_buffer.cpp
    src/ai/llm_engine.cpp
    src/ai/vlm_engine.cpp
    src/ai/rk_backends_unavailable.cpp
    src/router/intent_router.cpp
    src/app/request_processor.cpp
)

target_include_directories(
    multimodal_core
    PUBLIC
        ${CMAKE_CURRENT_SOURCE_DIR}/include
)

target_link_libraries(
    multimodal_core
    PUBLIC
        Threads::Threads
)

project_warnings(multimodal_core)

# ======================================================
# 4. Camera module
# ======================================================

if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
    set(
        CAMERA_CAPTURE_SOURCE
        src/video/video_capture.cpp
    )
else()
    set(
        CAMERA_CAPTURE_SOURCE
        src/video/video_capture_unavailable.cpp
    )

    message(STATUS
        "V4L2 unavailable: building portable "
        "core/CLI with explicit camera error"
    )
endif()

add_library(multimodal_camera
    src/video/camera_service.cpp
    ${CAMERA_CAPTURE_SOURCE}
)

target_link_libraries(
    multimodal_camera
    PUBLIC
        multimodal_core
)

project_warnings(multimodal_camera)

# ======================================================
# 5. Main application
# ======================================================

add_executable(rk3576_multimodal
    src/main.cpp
    src/app/cli.cpp
)

target_link_libraries(
    rk3576_multimodal
    PRIVATE
        multimodal_camera
)

project_warnings(rk3576_multimodal)

# ======================================================
# 6. Core tests
# ======================================================

include(CTest)

if(BUILD_TESTING)

    add_executable(core_tests
        tests/core_tests.cpp
    )

    target_link_libraries(
        core_tests
        PRIVATE
            multimodal_core
    )

    project_warnings(core_tests)

    add_test(
        NAME core_tests
        COMMAND core_tests
    )

    add_executable(camera_service_tests
        tests/camera_service_tests.cpp
        tests/camera_test_capture.cpp
        src/video/camera_service.cpp
    )

    target_include_directories(
        camera_service_tests
        PRIVATE
            tests
    )

    target_link_libraries(
        camera_service_tests
        PRIVATE
            multimodal_core
    )

    project_warnings(camera_service_tests)

    add_test(
        NAME camera_service_tests
        COMMAND camera_service_tests
    )

    add_test(
        NAME cli_smoke
        COMMAND ${CMAKE_COMMAND}
            -DAPP=$<TARGET_FILE:rk3576_multimodal>
            -DTEST_DATA=${CMAKE_CURRENT_SOURCE_DIR}/tests
            -P ${CMAKE_CURRENT_SOURCE_DIR}/tests/cli_smoke.cmake
    )

    set_tests_properties(
        core_tests
        camera_service_tests
        cli_smoke
        PROPERTIES
            TIMEOUT 20
    )

endif()

# ======================================================
# 7. Linux ALSA audio module
# ======================================================

if(CMAKE_SYSTEM_NAME STREQUAL "Linux")

    find_package(PkgConfig REQUIRED)

    pkg_check_modules(
        ALSA REQUIRED IMPORTED_TARGET alsa
    )

    add_library(multimodal_audio
        src/audio/audio_capture.cpp
        src/audio/audio_preprocessor.cpp
    )

    target_include_directories(
        multimodal_audio
        PUBLIC
            ${CMAKE_CURRENT_SOURCE_DIR}/include
    )

    target_link_libraries(
        multimodal_audio
        PUBLIC
            PkgConfig::ALSA
    )

    project_warnings(multimodal_audio)

    add_executable(audio_capture_smoke
        src/audio/audio_capture_smoke.cpp
    )

    target_link_libraries(
        audio_capture_smoke
        PRIVATE
            multimodal_audio
    )

    project_warnings(audio_capture_smoke)

    # AudioPreprocessor unit tests.
    if(BUILD_TESTING)

        add_executable(audio_preprocessor_tests
            tests/audio_preprocessor_tests.cpp
        )

        target_link_libraries(
            audio_preprocessor_tests
            PRIVATE
                multimodal_audio
        )

        project_warnings(audio_preprocessor_tests)

        add_test(
            NAME audio_preprocessor_tests
            COMMAND audio_preprocessor_tests
        )

    endif()

endif()

# ======================================================
# 8. sherpa-onnx ASR backend - Operation 6
# ======================================================

option(
    ENABLE_SHERPA_ASR
    "Build real sherpa-onnx ASR support"
    OFF
)

set(
    SHERPA_ONNX_ROOT
    ""
    CACHE PATH
    "Path to unpacked sherpa-onnx ARM64 runtime"
)

if(ENABLE_SHERPA_ASR)

    if(NOT CMAKE_SYSTEM_NAME STREQUAL "Linux")
        message(FATAL_ERROR
            "Sherpa ASR currently supports Linux only"
        )
    endif()

    set(
        SHERPA_C_API_HEADER
        "${SHERPA_ONNX_ROOT}/include/sherpa-onnx/c-api/c-api.h"
    )

    set(
        SHERPA_C_API_LIB
        "${SHERPA_ONNX_ROOT}/lib/libsherpa-onnx-c-api.so"
    )

    if(NOT EXISTS "${SHERPA_C_API_HEADER}")
        message(FATAL_ERROR
            "sherpa-onnx C API header not found"
        )
    endif()

    if(NOT EXISTS "${SHERPA_C_API_LIB}")
        message(FATAL_ERROR
            "sherpa-onnx C API library not found"
        )
    endif()

    add_library(
        sherpa_onnx_c_api
        SHARED IMPORTED
    )

    set_target_properties(
        sherpa_onnx_c_api
        PROPERTIES
            IMPORTED_LOCATION "${SHERPA_C_API_LIB}"
    )

    add_library(multimodal_asr
        src/audio/asr_service.cpp
    )

    target_include_directories(
        multimodal_asr
        PUBLIC
            "${CMAKE_CURRENT_SOURCE_DIR}/include"
        PRIVATE
            "${SHERPA_ONNX_ROOT}/include"
    )

    target_link_libraries(
        multimodal_asr
        PUBLIC
            multimodal_audio
        PRIVATE
            sherpa_onnx_c_api
    )

    project_warnings(multimodal_asr)

    add_executable(asr_live_smoke
        src/audio/asr_live_smoke.cpp
    )

    target_link_libraries(
        asr_live_smoke
        PRIVATE
            multimodal_asr
    )

    project_warnings(asr_live_smoke)

endif()

# ======================================================
# 9. Multithreaded ASR pipeline - Operation 7
# ======================================================

if(ENABLE_SHERPA_ASR)

    find_package(Threads REQUIRED)

    add_library(multimodal_asr_pipeline
        src/audio/asr_pipeline.cpp
    )

    target_include_directories(
        multimodal_asr_pipeline
        PUBLIC
            "${CMAKE_CURRENT_SOURCE_DIR}/include"
    )

    target_link_libraries(
        multimodal_asr_pipeline
        PUBLIC
            multimodal_asr
        PRIVATE
            Threads::Threads
    )

    project_warnings(multimodal_asr_pipeline)

    add_executable(asr_pipeline_smoke
        src/audio/asr_pipeline_smoke.cpp
    )

    target_link_libraries(
        asr_pipeline_smoke
        PRIVATE
            multimodal_asr_pipeline
            Threads::Threads
    )

    project_warnings(asr_pipeline_smoke)

endif()

# ======================================================
# 10. Silero VAD - Operation 8
# ======================================================

if(ENABLE_SHERPA_ASR)

    target_sources(
        multimodal_asr_pipeline
        PRIVATE
            src/audio/vad_audio_worker.cpp
    )

    target_include_directories(
        multimodal_asr_pipeline
        PRIVATE
            "${SHERPA_ONNX_ROOT}/include"
    )

    add_executable(asr_vad_smoke
        src/audio/asr_vad_smoke.cpp
    )

    target_link_libraries(
        asr_vad_smoke
        PRIVATE
            multimodal_asr_pipeline
            Threads::Threads
    )

    project_warnings(asr_vad_smoke)

endif()

# ======================================================
# 11. ASR -> RequestProcessor - Operation 9
# ======================================================

if(ENABLE_SHERPA_ASR)

    add_executable(asr_route_smoke
        src/audio/asr_route_smoke.cpp
    )

    target_link_libraries(
        asr_route_smoke
        PRIVATE
            multimodal_asr_pipeline
            multimodal_camera
    )

    project_warnings(asr_route_smoke)

endif()
