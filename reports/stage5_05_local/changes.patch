+    if(BUILD_TESTING)
+        add_executable(stage5_04_asr_bench tests/stage5_04_asr_bench.cpp)
+        target_link_libraries(stage5_04_asr_bench PRIVATE multimodal_audio)
+        project_warnings(stage5_04_asr_bench)
