+    };
+
+    // ------------------------------------------------------
+    // 13. 创建 ASRWorker 和 VadAudioWorker
+    // ------------------------------------------------------
+
+    ASRWorker consumer(
+        audio_queue,
+        asr,
+        print_mutex,
+        {},
+        [&](const std::string& text,const AudioSegment& segment){on_text(text,segment.trace);}
+    );
+
+    VadAudioWorker producer(
+        capture_device,
