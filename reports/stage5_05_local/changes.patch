+    // ------------------------------------------------------
+    // 22. 最终验收条件
+    // ------------------------------------------------------
+
+    const bool passed =
+        (replay_mode ? (!audio_replay_path || consumer.ok()) : (producer.ok() && consumer.ok())) && audio_queue.droppedCount()==0 &&
