+
+    std::cout
+        << "[Init] Loading RKLLM...\n"
+        << std::flush;
+
+    if (!llm.initialize(
+            BackendConfig{llm_model, {}},
+            error))
+    {
+        std::cerr
+            << "[Init] RKLLM failed: "
+            << error
+            << '\n';
+
+        return 1;
+    }
+
+    // ------------------------------------------------------
+    // 5. 初始化 SenseVoice
+    // ------------------------------------------------------
+
+    ASRService asr;
+
+    std::cout
+        << "[Init] Loading SenseVoice...\n"
+        << std::flush;
+
+    if (!asr.initialize(
+            asr_model,
+            asr_tokens,
+            error))
+    {
+        std::cerr
+            << "[Init] ASR failed: "
+            << error
+            << '\n';
+
+        llm.shutdown();
+
+        return 1;
+    }
+
+    // ------------------------------------------------------
+    // 6. 初始化 Kokoro TTS
+    // ------------------------------------------------------
+
+    TTSService tts;
+
+    std::cout
+        << "[Init] Loading Kokoro...\n"
+        << std::flush;
+
+    if (!tts.initialize(
+            kokoro_dir,
+            error,
+            tts_threads,
+            sid))
+    {
+        std::cerr
+            << "[Init] Kokoro failed: "
+            << error
+            << '\n';
+
+        llm.shutdown();
+
+        return 1;
+    }
+
+    // ------------------------------------------------------
+    // 7. 初始化 ALSA Playback
+    // ------------------------------------------------------
+
+    AlsaPlaybackService playback;
+
