+    // 2. 解析可选参数
+    // ------------------------------------------------------
+
+    try
+    {
+        const auto parse = [](
+            const char* arg,
+            int lo,
+            int hi
+        ) -> int
+        {
+            const std::string value(arg);
+
+            std::size_t used = 0;
+
+            const int result =
+                std::stoi(value, &used);
+
+            if (used != value.size() ||
+                result < lo ||
+                result > hi)
+            {
+                throw std::invalid_argument(
+                    "out of range"
+                );
+            }
+
+            return result;
+        };
+
+        if (argc >= 8)
+        {
+            record_seconds =
+                static_cast<unsigned int>(
+                    parse(argv[7], 1, 120)
+                );
+        }
+
+        if (argc >= 9)
+        {
+            tts_threads =
+                parse(argv[8], 1, 8);
+        }
+
+        if (argc >= 10)
+        {
+            sid =
+                parse(argv[9], 0, 10000);
+        }
+    }
+    catch (const std::exception&)
+    {
+        std::cerr
+            << "[Args] Invalid record_seconds / "
