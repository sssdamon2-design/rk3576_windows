+
+class GatedLLM final : public ILLMBackend
+{
+public:
+    std::promise<void> entered;
+    std::promise<void> release;
+    std::shared_future<void> gate =
+        release.get_future().share();
+
+    int calls = 0;
+
+    bool initialize(
+        const BackendConfig&,
+        std::string& error) override
+    {
+        error.clear();
+        return true;
+    }
