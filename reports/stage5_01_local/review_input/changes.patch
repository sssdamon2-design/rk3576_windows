+        error = "Both --vlm-model and --vision-model are required";
+        return false;
+    }
+    auto next = std::make_unique<Impl>();
+    next->rkllmPath = config.model_path;
+    next->rknnPath = config.vision_model_path;
+    int ret = rknn_init(&next->rknn,
