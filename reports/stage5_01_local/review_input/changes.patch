+        << "[Init] Loading TTS model...\n"
+        << std::flush;
+
+    const auto init_start =
+        std::chrono::steady_clock::now();
+
+    if (!tts.initialize(
+            model_dir,
+            error,
+            threads,
+            sid))
+    {
+        std::cerr
+            << "[Init] FAIL: "
+            << error << '\n';
+
+        return 1;
+    }
+
+    const double init_ms =
+        std::chrono::duration<double, std::milli>(
+            std::chrono::steady_clock::now() -
+            init_start
+        ).count();
+
+    std::cout
+        << "[Init] OK init_ms="
+        << init_ms << '\n';
+
+    // ALSA 使用 TTS 模型的实际采样率。
+    if (!playback.open(
+            device,
+            tts.sampleRate(),
+            error))
+    {
+        std::cerr
+            << "[ALSA] Open FAIL: "
+            << error << '\n';
+
+        return 1;
+    }
+
