+        }
+
+        lock.unlock();
+
+        ++heartbeats;
+
+        std::lock_guard<std::mutex> print_lock(print_mutex);
+
+        std::cout
+            << "\n[Main] heartbeat #"
+            << heartbeats
+            << ": main thread is responsive\n"
+            << std::flush;
+    }
+
+    // 正确的停止和资源释放顺序。
+    worker.requestStop();
+    worker.join();
+
+    llm.shutdown();
+
+    std::lock_guard<std::mutex> lock(print_mutex);
+
+    std::cout
+        << "\n[Main] completed: success="
+        << std::boolalpha
+        << final_result.success
+        << ", stream_chunks="
+        << chunk_count
+        << ", queue_wait_ms="
+        << queue_wait_ms
+        << ", first_text_ms="
