+
+        std::cout
+            << std::fixed
+            << std::setprecision(2)
+            << "[Main] submit returned in "
+            << submit_ms
+            << " ms (NPU inference is running in worker thread)\n";
+    }
+
+    // 主线程每隔两秒继续执行自己的任务。
+    std::size_t heartbeats = 0;
+
+    for (;;)
+    {
+        std::unique_lock<std::mutex> lock(state_mutex);
+
+        if (done_cv.wait_for(
+                lock,
+                std::chrono::seconds(2),
+                [&] { return done; }))
+        {
