+    constexpr std::uint32_t nv12=std::uint32_t('N')|(std::uint32_t('V')<<8)|(std::uint32_t('1')<<16)|(std::uint32_t('2')<<24);
+    CameraService camera(argv[4],3840,2160,nv12,frames);
