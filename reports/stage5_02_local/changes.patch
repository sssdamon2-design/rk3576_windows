-
-                    result.sample_rate =
-                        audio.sample_rate;
-
-                    result.audio_seconds =
-                        static_cast<double>(
-                            audio.samples.size()
-                        ) / audio.sample_rate;
-
-                    // 记录本次播放前的 XRUN 总数。
