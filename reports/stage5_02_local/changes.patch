+            << "\n=== ASR -> LLM -> TTS summary ===\n"
+
+            << "VAD segments: "
+            << producer.producedCount()
+            << '\n'
+
+            << "ASR recognized: "
+            << consumer.processedCount()
+            << '\n'
+
+            << "Audio queue dropped: "
+            << audio_queue.droppedCount()
+            << '\n'
+
+            << "LLM accepted/completed/"
+            << "success/failed/rejected: "
+            << llm_accepted
+            << '/'
+            << llm_completed
+            << '/'
+            << llm_successful
+            << '/'
+            << llm_failed
+            << '/'
+            << llm_rejected
+            << '\n'
+
+            << "TTS accepted/completed/"
+            << "success/failed/rejected/empty: "
+            << tts_accepted
+            << '/'
+            << tts_completed
+            << '/'
+            << tts_successful
+            << '/'
+            << tts_failed
+            << '/'
+            << tts_rejected
+            << '/'
+            << tts_empty
+            << '\n'
+
+            << "Skipped VISION: "
+            << skipped_vision
+            << '\n'
+            << "VISION completed/success/failed: "
+            << vision_completed << '/'
+            << vision_successful << '/'
+            << vision_failed << '\n';
+
+        if (!replay_mode && !producer.ok())
+        {
+            std::cerr
+                << "[VAD] "
+                << producer.error()
+                << '\n';
+        }
+
+        if (!replay_mode && !consumer.ok())
+        {
+            std::cerr
+                << "[ASR] "
+                << consumer.error()
+                << '\n';
+        }
+    }
