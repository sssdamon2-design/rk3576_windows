+    // 19. 等待全部 TTS 任务完成
+    // ------------------------------------------------------
+    //
+    // 必须先等待 accepted == completed，
+    // 然后再 requestStop。
+    //
+    // 否则会把队列中等待的 TTS 任务取消。
+    // ------------------------------------------------------
+
+    const bool tts_drained =
+        wait_for_jobs(
+            "TTS",
+            tts_worker,
+            600
+        );
+
+    if (!tts_drained)
+    {
+        std::cerr
+            << "[Timeout] TTS tasks "
+            << "did not finish in 600s\n";
+    }
